# x402-trustgate Configuration

# Server Port
PORT=3000
NODE_ENV=production

# Base Mainnet Payment Wallet (EVM address receiving USDC payments)
# Existing CanaryGuard recipient wallet
PAY_TO_WALLET=0x73279fa4BadA7CAC888c62CDa4f5c8104765f6f1

# Upstream CanaryGuard Service URL (Keep-alive ping & 307 proxy target)
UPSTREAM_CANARYGUARD_URL=https://canaryguard-402.onrender.com

# x402 Facilitator Endpoint for signature verification & settlement
# Can be x402.org or CDP facilitator (e.g. https://api.cdp.coinbase.com/platform/mobile/x402 or https://x402.org/facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Keep-alive ping interval in minutes (default: 9)
KEEP_ALIVE_INTERVAL_MINUTES=9
